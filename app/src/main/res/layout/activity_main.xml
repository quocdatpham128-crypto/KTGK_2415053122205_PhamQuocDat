<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F0F2F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Card thông tin sinh viên (có khung màu nổi bật) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:elevation="4dp"
            app:cardCornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:cardBackgroundColor="#E3F2FD">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👤 THÔNG TIN SINH VIÊN"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Họ tên: Phạm Quốc Đạt"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0D47A1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MSV: 2415053122205  |  Lớp: 24T2"
                    android:textSize="13sp"
                    android:textColor="#1976D2"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tiêu đề chính -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💰 QUẢN LÝ CHI TIÊU"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#6200EE"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Khung chứa form nhập liệu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/edtTenKhoanChi_205"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Nhập tên khoản chi"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:background="@android:drawable/editbox_background_normal"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/edtSoTien_205"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Nhập số tiền"
                android:inputType="numberDecimal"
                android:paddingHorizontal="16dp"
                android:background="@android:drawable/editbox_background_normal"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/edtGhiChu_205"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Nhập ghi chú"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:background="@android:drawable/editbox_background_normal"
                android:layout_marginBottom="12dp" />

            <CheckBox
                android:id="@+id/chkDaThanhToan_205"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã thanh toán"
                android:textSize="15sp"
                android:textColor="#333333" />
        </LinearLayout>

        <!-- Các nút bấm màu sắc nổi bật -->
        <Button
            android:id="@+id/btnThemKhoanChi_205"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Thêm khoản chi"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#6200EE"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnXemChiTiet_205"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Xem chi tiết khoản chi"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#03DAC6"
            android:textColor="#000000" />

    </LinearLayout>
</ScrollView>