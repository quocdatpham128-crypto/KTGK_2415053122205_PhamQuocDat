<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/edtTenKhoanChi_205"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tên khoản chi" />

    <EditText
        android:id="@+id/edtSoTien_205"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập số tiền"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/edtGhiChu_205"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập ghi chú" />

    <CheckBox
        android:id="@+id/chkDaThanhToan_205"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đã thanh toán"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnThemKhoanChi_205"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thêm khoản chi"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnXemChiTiet_205"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xem chi tiết khoản chi"
        android:layout_marginTop="8dp" />

</LinearLayout>